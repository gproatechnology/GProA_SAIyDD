# Ejemplo de configuración del backend SaIyDD (copiar a .env)
APP_NAME=SaIyDD Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./saiydd.db
CORS_ORIGINS=http://localhost:5174

# Autenticación de tutores (bcrypt + JWT)
JWT_SECRET=cambia-este-valor-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
